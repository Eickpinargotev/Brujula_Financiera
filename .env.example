# ==========================================================================
# Brújula Financiera — Variables de entorno (PLANTILLA)
# Copia este archivo a .env y completa los valores. NO subas .env al repo.
#
# IMPORTANTE: aquí SOLO van infraestructura y secretos.
# Los parámetros financieros y las metas NO van aquí: viven en la BASE DE DATOS
# (se siembran al iniciar) y se consultan/editan por Telegram o el dashboard.
# ==========================================================================

# --- Entorno / despliegue ------------------------------------------------
APP_ENV=development                  # development | production

# --- Telegram ------------------------------------------------------------
# Token del bot (lo da @BotFather)
TELEGRAM_BOT_TOKEN=
# Tu chat_id numérico: el bot SOLO atiende a este id (escribe a @userinfobot)
TELEGRAM_ALLOWED_CHAT_ID=

# --- OpenAI (agente: GPT-4o-mini) ----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ElevenLabs (transcripción voz→texto: Scribe v2, batch / NO realtime) -
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# --- Dashboard (seguridad) -----------------------------------------------
# Contraseña única para abrir el dashboard
DASHBOARD_PASSWORD=
# Secreto largo y aleatorio para firmar la sesión (ej: openssl rand -hex 32)
SESSION_SECRET=

# --- Base de datos -------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////data/brujula.db

# --- Repositorio (solo referencia; NO lo usa la app) ---------------------
# Pega aquí la URL de tu repo de GitHub para inicializar/subir el proyecto.
# GITHUB_REPO_URL=
