# ==========================================================================
# Brújula Financiera — Variables de entorno (PLANTILLA)
# Copia este archivo a .env y completa los valores. NO subas .env al repo.
#
# REGLA: aquí SOLO van SECRETOS e INFRAESTRUCTURA fija. Nada que "varíe":
#  - Parámetros financieros y metas → en la BASE DE DATOS (se siembran al iniciar).
#  - Ids de modelos (OpenAI/ElevenLabs) → defaults en código (config/settings.py).
# ==========================================================================

# --- Entorno / despliegue ------------------------------------------------
# development = local (el bot NO hace polling) · production = nube (el bot SÍ hace polling)
APP_ENV=development

# --- Telegram ------------------------------------------------------------
# Token del bot (lo da @BotFather)
TELEGRAM_BOT_TOKEN=
# Tu chat_id numérico: el bot SOLO atiende a este id (escribe a @userinfobot)
TELEGRAM_ALLOWED_CHAT_ID=

# --- OpenAI (agente) -----------------------------------------------------
OPENAI_API_KEY=

# --- ElevenLabs (transcripción de voz) -----------------------------------
ELEVENLABS_API_KEY=

# --- Dashboard (seguridad) -----------------------------------------------
# Contraseña única para abrir el dashboard
DASHBOARD_PASSWORD=
# Secreto largo y aleatorio para firmar la sesión (ej: openssl rand -hex 32)
SESSION_SECRET=

# --- Base de datos -------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////data/brujula.db
