# ==========================================================================
# Brújula Financiera — Variables de entorno (PLANTILLA)
# Copia este archivo a .env y completa los valores. NO subas .env al repo.
#
# REGLA: aquí SOLO van SECRETOS e INFRAESTRUCTURA fija. Nada que "varíe":
#  - Parámetros financieros y metas → en la BASE DE DATOS (se siembran al iniciar).
# ==========================================================================

# --- Entorno / despliegue ------------------------------------------------
# development = local · production = nube
APP_ENV=development

# --- Dashboard (seguridad) -----------------------------------------------
# Contraseña única para abrir el dashboard
DASHBOARD_PASSWORD=
# Secreto largo y aleatorio para firmar la sesión (ej: openssl rand -hex 32)
SESSION_SECRET=

# --- Base de datos -------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////data/brujula.db
ALLOW_DATABASE_CREATE=false
